# AI Cybersecurity Fraud Detection System Configuration

# Database Configuration
DATABASE_URL=sqlite:///./fraud_detection.db

# API Keys (Optional - for enhanced threat intelligence)
# Get your free API key from https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Hybrid Analysis API key (Optional)
# Get from https://www.hybrid-analysis.com/
HYBRID_ANALYSIS_API_KEY=your_hybrid_analysis_api_key_here

# Security Settings
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Settings
MAX_FILE_SIZE=104857600  # 100MB in bytes
UPLOAD_DIR=./uploads

# Machine Learning Settings
MODEL_CONFIDENCE_THRESHOLD=0.7
ENABLE_LEARNING=true

# API Rate Limiting
API_RATE_LIMIT=100  # requests per hour

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000